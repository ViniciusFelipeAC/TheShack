# The Shack usa só o login da sua assinatura no Claude Code.
# Não coloque ANTHROPIC_API_KEY aqui: o servidor remove essa variável de propósito.

# Endereço do servidor. 127.0.0.1 = só este PC. O celular chega pelo Tailscale ("tailscale serve --bg 4321"), sem mudar isto.
SHACK_HOST=127.0.0.1
SHACK_PORT=4321

SHACK_TZ=America/Sao_Paulo
SHACK_DB_PATH=./data/shack.db
SHACK_AGENTS_DIR=./agents

# Modelo usado quando nenhum da lista do manifesto estiver disponível no seu plano.
SHACK_FALLBACK_MODEL=sonnet

# sdk: o etnaD trabalha de verdade (Claude Code, usa a cota do seu plano).
# simulated: o etnaD só finge trabalhar, útil para testar a interface sem gastar cota.
SHACK_RUNNER=sdk

# Por quantos dias os eventos ficam guardados.
SHACK_EVENT_RETENTION_DAYS=30

# Pasta do app web gerado por "npm run build". O servidor entrega o app no mesmo endereço da API.
SHACK_WEB_DIR=./apps/web/dist

# Onde ficam as fotos e arquivos anexados no chat. Anexo enviado e não usado em 24 horas é apagado.
SHACK_UPLOADS_DIR=./data/uploads

# Chaves do push do navegador (opcional). Se ficarem vazias, a Shack gera e guarda no banco sozinha.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# O push da Apple (iPhone) exige um mailto: ou https: válido aqui. Se o iPhone não receber, ponha o seu e-mail.
# VAPID_SUBJECT=mailto:voce@exemplo.com
